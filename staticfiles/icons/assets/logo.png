<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" fill="none">
  <!-- Стрелка слева -->
  <g id="arrow">
    <path d="M 30 80 Q 20 100 30 120" stroke="#18B06D" stroke-width="6" fill="none" stroke-linecap="round"/>
    <path d="M 40 85 Q 35 100 40 115" stroke="#18B06D" stroke-width="6" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Линии скорости -->
  <g id="speed-lines">
    <line x1="50" y1="60" x2="70" y2="55" stroke="#18B06D" stroke-width="3" stroke-linecap="round"/>
    <line x1="50" y1="70" x2="75" y2="68" stroke="#18B06D" stroke-width="3" stroke-linecap="round"/>
  </g>
  
  <!-- Грузовик -->
  <g id="truck">
    <!-- Кузов -->
    <rect x="75" y="95" width="45" height="30" fill="#18B06D" rx="3"/>
    
    <!-- Галочка на кузове -->
    <path d="M 85 110 L 92 117 L 102 107" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    
    <!-- Кабина -->
    <rect x="120" y="100" width="25" height="25" fill="#18B06D" rx="2"/>
    
    <!-- Окно кабины -->
    <rect x="128" y="105" width="12" height="12" fill="#B3EACD" rx="1"/>
    
    <!-- Переднее колесо -->
    <circle cx="85" cy="130" r="8" fill="none" stroke="#18B06D" stroke-width="2"/>
    <circle cx="85" cy="130" r="4" fill="#18B06D"/>
    
    <!-- Заднее колесо -->
    <circle cx="130" cy="130" r="8" fill="none" stroke="#18B06D" stroke-width="2"/>
    <circle cx="130" cy="130" r="4" fill="#18B06D"/>
  </g>
</svg>